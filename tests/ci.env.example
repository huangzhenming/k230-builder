# tests/ci.env — self-hosted runner configuration for tests/report.sh (T2-T4).
# Copy to tests/ci.env (gitignored) on the runner and adjust the paths.
# Every value below shows its default; only K230_CI_WORKSPACE is required.

# Image tag the pipeline builds (stage 'image') and tests against.
#K230_CI_IMAGE=k230-builder:regression

# Persistent docker volume for toolchains + conan/NuGet caches.
# First run downloads ~5GB; afterwards toolchain stages are near-free.
#K230_CI_VOLUME=k230_toolchains_ci

# Workspace root holding the SDK / nncase checkouts, laid out like the README
# recommends (t4 runtime builds mount THIS dir, so SDKs must live inside it):
#   $K230_CI_WORKSPACE/
#   ├── k230_linux_sdk/      built by stage sdk-linux, reused by nncase-runtime-linux
#   ├── k230_rtos_sdk/       built by stage sdk-rtos,  reused by nncase-runtime-rtos
#   ├── k230_nuttx_sdk/      west workspace, built by stage sdk-nuttx
#   ├── nncase/              base repo (auto-cloned by scripts/nncase if missing)
#   └── nncase-k80/          plugin repo — REQUIRED for the nncase-* stages
K230_CI_WORKSPACE=$HOME/k230-ci

# SDK dir names under the workspace (or absolute paths) and build commands.
# The Linux SDK's default full build is heavy (kernel + full rootfs + apps).
# If your k230_linux_sdk checkout supports a smaller/faster target (e.g. a
# leaner defconfig, or a single-component target like "make uboot"/"make
# linux"), point K230_CI_LINUX_CMD at that instead of the full image build —
# t3-sdk.sh only asserts a fresh matching K230_CI_LINUX_ART artifact, so pair
# a narrower command with a narrower --ART glob.
#K230_CI_LINUX_SDK=k230_linux_sdk
#K230_CI_LINUX_CMD="make CONF=k230_canmv_defconfig"
#K230_CI_RTOS_SDK=k230_rtos_sdk
#K230_CI_RTOS_CMD="make CONF=k230_canmv_defconfig"
#K230_CI_NUTTX_SDK=k230_nuttx_sdk
#K230_CI_NUTTX_CMD="west build"

# Artifact glob asserted after each SDK build (find -name, newer than build
# start, >1MB). Tighten per SDK if *.img is too loose.
#K230_CI_LINUX_ART=*.img
#K230_CI_RTOS_ART=*.img
#K230_CI_NUTTX_ART=*.img

# NuttX export sysroot dir (under the workspace, needs include/) for the
# nncase-runtime-nuttx stage; leave unset to skip that stage.
#K230_CI_NUTTX_EXPORT=nuttx-export

# Where reports/logs land (default: <repo>/reports, gitignored).
#K230_CI_REPORT_DIR=
